NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_ORIGIN=http://localhost:4300
CORS_ORIGINS=http://localhost:4300
LOG_LEVEL=debug
DATABASE_URL=postgresql://esoteric_admin:change_me@localhost:5432/esoteric_library?schema=public
DIRECT_DATABASE_URL=postgresql://esoteric_admin:change_me@localhost:5432/esoteric_library?schema=public
REDIS_URL=redis://localhost:6379
RELEASE_VERSION=local
SWAGGER_ENABLED=true
METRICS_ENABLED=false
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_PEPPER=replace_with_a_different_32_character_secret
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
PAYU_ENV=test
PAYU_KEY=replace_with_payu_merchant_key
PAYU_SALT=replace_with_payu_server_salt
PAYU_BASE_URL=https://test.payu.in
PAYU_SUCCESS_URL=http://localhost:3000/api/v1/payments/payu/return/success
PAYU_FAILURE_URL=http://localhost:3000/api/v1/payments/payu/return/failure
PAYU_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
ENCRYPTION_MASTER_KEY=replace_with_a_separate_32_character_secret
INTERNAL_API_KEY=replace_with_a_separate_32_character_secret
STORAGE_WEBHOOK_SECRET=replace_with_a_separate_32_character_secret
EMAIL_WEBHOOK_SECRET=replace_with_a_separate_32_character_secret
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
